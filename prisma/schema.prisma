generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// Entidades do Negócio (Nicho 6: Academia)
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user") // "admin" (instrutor) ou "user" (aluno)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workouts      Workout[] // Relação 1:N - Um instrutor cria várias fichas
  
  // Tabelas obrigatórias do Better Auth
  sessions      Session[]
  accounts      Account[]
}

model Workout {
  id          String   @id @default(cuid())
  title       String   // Ex: "Treino A - Peito e Tríceps"
  description String   // Exercícios, repetições, carga
  imageUrl    String?  // Upload do Vercel Blob
  createdAt   DateTime @default(now())
  
  // Chave Estrangeira ligando a Ficha ao Usuário (Instrutor/Aluno)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// Tabelas do Sistema (Better Auth)
// ==========================================

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}